<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>motion_acq_nova2</name>
  <version>0.1.0</version>
  <description>Nova 2 glove read straight from the SenseGlove SDK (SGCore), as Nova2Dex reads it: normalized flexion, thumb rotation, raw sensors.</description>
  <maintainer email="ukwh5681@gmail.com">divingyoon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>senseglove_api</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
